# Binaries
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Data (runtime generated)
data/skills.json

# Deploy runtime artifacts
deploy/run/
deploy/logs/

# 配置覆盖层（CLI /config set 生成，本地个性化配置）
config.local.yaml

# 本地运行产物（审计日志、IDE 工具配置）
data/audit.jsonl
.qwen/

# 记忆持久化运行产物（memstore file/sqlite 后端）
data/memories/
data/memory.db
# sqlite WAL 模式边车文件（memstore 启用 journal_mode=WAL 后产生）
data/memory.db-shm
data/memory.db-wal
data/*.db-shm
data/*.db-wal

# 误建在仓库根目录的构建产物（go build ./cmd/xxx 会在当前目录留下同名二进制）
/server
/tommy-agent
/tommy-server
/tommy-memstore
